# Environment Configuration
NODE_ENV=development
APP_URL=http://localhost:3000

# Database (SQLite for local zero-dependency development; PostgreSQL in production)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL for production:
# DATABASE_URL="postgresql://user:password@host:5432/convora_store?sslmode=require"

# Security & Secrets
JWT_SECRET=convora-jwt-secret-key-at-least-32-characters-long-2026
# 32-byte hex key for AES-256-GCM inventory credential encryption at rest
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Razorpay (Test mode credentials)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_test_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder
RAZORPAY_MODE=test

# Meta Pixel & Conversions API (CAPI)
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# Store Support
STORE_NAME="Convora Store"
SUPPORT_EMAIL="support@convora.store"
SUPPORT_WHATSAPP="919990798996"
