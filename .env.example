APP_NAME="CapCut Pro Store"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourstore.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Configuration (MySQL for Shared Hosting / cPanel)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpanel_capcutdb
DB_USERNAME=cpanel_dbuser
DB_PASSWORD=your_strong_db_password

# Session & Cache (Database drivers work on shared hosting without Redis)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# Mail Configuration (SMTP from cPanel or Mailgun/Brevo)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.yourstore.com
MAIL_PORT=465
MAIL_USERNAME=support@yourstore.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="orders@yourstore.com"
MAIL_FROM_NAME="CapCut Pro Store"

# Razorpay Payment Gateway (Controlled via Admin Panel > Settings > Payment Settings)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Customer Support & Direct Order
WHATSAPP_NUMBER=919876543210

# Meta Ads Tracking (Pixel & Conversions API)
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# Configurable Product Pricing
CAPCUT_PRODUCT_PRICE=499.00
CAPCUT_PRODUCT_SALE_PRICE=299.00
