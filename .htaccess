<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive files and directories
    RewriteRule ^\.env.* - [F,L,NC]
    RewriteRule ^database/ - [F,L,NC]
    RewriteRule ^storage/logs/ - [F,L,NC]
    RewriteRule ^tests/ - [F,L,NC]
    RewriteRule ^composer\.(json|lock) - [F,L,NC]
    RewriteRule ^package(-lock)?\.json - [F,L,NC]

    # Direct all web requests through the /public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    RedirectMatch 302 ^/$ /public/
</IfModule>
